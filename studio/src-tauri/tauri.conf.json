{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hexforge Studio",
  "version": "0.1.0",
  "identifier": "com.hexforge.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hexforge Studio",
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0A0C12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
